      },
      "id": "4ddc68a1-9318-4d3d-8dfa-42baaf2c27bf",
      "name": "Weekly YC Sync Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        440
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "eab9505e-2f6a-4b52-a2b3-0bb05f551729",
              "name": "apifyToken",
              "value": "YOUR_APIFY_API_TOKEN",
              "type": "string"
            },
            {
              "id": "d2a23364-dbcc-4ad1-873a-8d3783a19bd8",
              "name": "spreadsheetId",
              "value": "YOUR_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "8da5f981-80cd-4fc8-be8b-9936d0451ac1",
              "name": "batch",
              "value": "W25",
              "type": "string"
            },
            {
              "id": "3bff4c23-5f10-4985-99d8-4e35ed7db120",
              "name": "maxCompanies",
              "value": 25,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "70d81aca-f4ed-40c4-9520-0f98cd9f8473",
      "name": "Set YC Batch & Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/mehdad-datalabs~y-combinator-yc-startup-directory-b2b-lead-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $json.apifyToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ batch: $json.batch, maxResults: $json.maxCompanies }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "6e9faae9-797c-4a75-8f53-fc625b2e7c0c",
      "name": "Run Apify YC Startup Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "2edeaac7-456a-4770-9e79-23aa244ec172",
              "leftValue": "={{ $json.website || $json.companyUrl || '' }}",
              "rightValue": "http",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f47438cb-a716-4c3f-af7a-81fb857a792e",
      "name": "Filter Startups With Website",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1000,
        340
      ]
    },
