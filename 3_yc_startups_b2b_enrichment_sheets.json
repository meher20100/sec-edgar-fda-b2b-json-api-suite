      "name": "Limit Startups",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1240,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/mehdad-datalabs~b2b-website-email-phone-social-links-tech-stack-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $('Set YC Batch & Config').first().json.apifyToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: [$json.website || $json.companyUrl] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "6835b35e-8961-4136-8b09-8e310b1aff49",
      "name": "Enrich B2B Email & Tech Stack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const sheetId = $('Set YC Batch & Config').first().json.spreadsheetId;\nreturn $input.all().map(item => {\n  const d = item.json;\n  const emails = Array.isArray(d.emails) ? d.emails : (d.email ? [d.email] : []);\n  const tech = Array.isArray(d.techStack) ? d.techStack.join(', ') : (d.techStack || '');\n  return {\n    json: {\n      spreadsheetId: sheetId,\n      website: d.url || d.website || '',\n      primaryEmail: emails[0] || '',\n      allEmails: emails.join(', '),\n      phone: Array.isArray(d.phones) ? (d.phones[0] || '') : (d.phone || ''),\n      linkedin: d.linkedin || d.socialLinks?.linkedin || '',\n      techStack: tech,\n      hasEmail: emails.length > 0\n    }\n  };\n});"
      },
      "id": "9d586d19-e6e3-4874-8e33-b927aeeb321f",
      "name": "Score & Format B2B Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "2846fabb-6014-4ad3-865f-28a830f87c0f",
              "leftValue": "={{ $json.hasEmail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0ede96be-14e8-40eb-a0fe-ff879efe270a",
      "name": "Has Contact Email?",
